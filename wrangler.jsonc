{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "goko-hostel-latest-webpage",
	// Used by local/GitHub `wrangler deploy` only. Cloudflare Workers Builds ignores this — set Build command to `npm run cf:build` in the dashboard.
	"build": {
		"command": "npm run cf:build"
	},
	"main": "worker.ts",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		// Inventory retry: every 5 minutes. Mapping check: 09:00 IST. Reconciliation: 10:00, 12:00, 14:00, 16:00, 18:00, 20:00 and 22:00 IST (UTC cron).
		"crons": ["*/5 * * * *", "30 3 * * *", "30 4,6,8,10,12,14,16 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "goko-hostel-db",
			"database_id": "03946725-70cb-4c9e-babd-8292e673a7fa"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "goko-media"
		}
	],
	// v1 created OpenNext's ISR Durable Object (Workers Free 10ms cannot SSR those pages).
	// v2 deletes it. Do not re-add DO / incremental-cache R2 bindings.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["DOQueueHandler"]
		}
	]
}
