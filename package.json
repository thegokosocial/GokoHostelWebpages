{
  "name": "goko-premium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "frro:server": "tsx scripts/frro-server.ts",
    "analyze": "ANALYZE=true next build",
    "cf:build": "BUILD_VERSION=$(git rev-parse --short HEAD 2>/dev/null || echo unknown) opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply goko-hostel-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply goko-hostel-db --remote",
    "build:pi": "GOKO_RUNTIME=pi BUILD_VERSION=$(git rev-parse --short HEAD 2>/dev/null || echo unknown) next build",
    "start:pi": "GOKO_RUNTIME=pi next start -p 3000",
    "db:migrate:pi": "GOKO_RUNTIME=pi tsx scripts/migrate-pi.ts",
    "seed:pi": "GOKO_RUNTIME=pi tsx scripts/seed-pi.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.18.0",
    "@pushforge/builder": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.4.7",
    "googleapis": "^171.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "next": "15.5.14",
    "qr-code-styling": "^1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "tailwind-merge": "^2.6.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.14",
    "postcss": "^8.4.49",
    "shadcn": "^4.1.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.80.0"
  }
}
